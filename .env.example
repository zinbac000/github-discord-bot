# Copy to .env and fill in. Never commit .env.

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Fine-grained GitHub PAT with Issues: read and write on the one repo below
GITHUB_TOKEN=

# The single repo the bot manages, as owner/name
GITHUB_REPO=owner/name

# ID of the Discord role allowed to run write commands (create, close, comment)
ALLOWED_ROLE_ID=

# Optional: server ID. Commands then appear instantly instead of up to an hour.
DISCORD_GUILD_ID=

# Optional: most issues one person can create per hour, across /issue create, /bulk
# create, /ask and tagging. Default 20. 0 means no cap.
CREATE_LIMIT_PER_HOUR=

# Optional: natural-language input via Groq (/ask and tagging the bot).
# Leave GROQ_API_KEY empty to disable it. Messages are sent to Groq.
GROQ_API_KEY=
# Groq retires models; check https://console.groq.com/docs/models for a current
# tool-calling model. Empty uses the built-in default.
GROQ_MODEL=
# Optional model to retry with when GROQ_MODEL is unavailable
GROQ_FALLBACK_MODEL=

# Optional: lets people say "assign to me" or tag a teammate. Comma-separated
# <discord user id>=<github login> pairs. Without it, only typed GitHub logins work.
GITHUB_USER_MAP=
